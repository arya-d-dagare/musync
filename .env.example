# Copy this file to .streamlit/secrets.toml (Streamlit's native format)
# OR to a .env file loaded via python-dotenv - the app reads via
# modules/config.py which checks st.secrets first, then os.environ.
#
# EVERY value below is OPTIONAL. The app degrades gracefully and tells
# you in the UI what mode it's running in if any of these are missing:
#   - No MONGO_URI            -> local JSON-file storage (data/local_store/)
#   - No BREVO_API_KEY/etc.   -> simple local sign-in instead of OTP email
#
# ---- If using .streamlit/secrets.toml, format is: ----
# MONGO_URI = "mongodb+srv://user:password@cluster.mongodb.net/"
# BREVO_API_KEY = "xkeysib-..."
# SENDER_EMAIL = "no-reply@yourdomain.com"
# HOST_EMAILS = "person1@example.com,person2@example.com"
#
# ---- If using a plain .env file, format is: ----
MONGO_URI=
BREVO_API_KEY=
SENDER_EMAIL=
HOST_EMAILS=
